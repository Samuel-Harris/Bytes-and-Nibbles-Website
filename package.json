{
  "name": "bytes-and-nibbles-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"*\" dev",
    "dev:cms": "pnpm --filter bytes-and-nibbles-cms dev",
    "dev:website": "pnpm --filter bytes-and-nibbles-website dev",
    "build": "pnpm --filter \"*\" --parallel build",
    "build:cms": "pnpm --filter bytes-and-nibbles-cms build",
    "build:website": "pnpm --filter bytes-and-nibbles-website build",
    "preview:cms": "pnpm --filter bytes-and-nibbles-cms preview",
    "test": "pnpm --filter \"*\" --parallel test",
    "lint": "pnpm --filter \"*\" --parallel lint",
    "check:unused-deps": "knip --include dependencies --treat-config-hints-as-errors",
    "clean": "pnpm --filter \"*\" clean && rm -rf node_modules"
  },
  "devDependencies": {
    "knip": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.13",
      "@types/react-dom": "19.2.3"
    }
  }
}
